      "teacher_backbone": "R101",
      "student_backbone": "R18",
      "role": "representative pair",
      "teacher_ap": 50.12,
      "student_ap": 46.50,
      "teacher": "checkpoints/CR-01_teacher.pt",
      "student": "checkpoints/CR-01_student.pt"
    },
    "CR-02": {
