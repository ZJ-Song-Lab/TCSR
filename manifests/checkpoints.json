      "model": "rtdetr",
      "teacher_backbone": "R101",
      "student_backbone": "R18",
      "role": "replication pair (B/G)",
      "teacher": "checkpoints/CR-02_teacher.pt",
      "student": "checkpoints/CR-02_student.pt"
    },
    "CR-03": {
